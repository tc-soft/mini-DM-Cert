---
import Layout from "@/layouts/Layout.astro";
import AppNav from "@/components/AppNav.astro";
import { getDashboardStats } from "@/lib/orders";
import { formatMoney } from "@/lib/money";
import { TriangleAlert, Ban, CircleDollarSign, Wallet } from "lucide-react";

const { user } = Astro.locals;
if (!user) {
  return Astro.redirect("/auth/signin");
}

const stats = getDashboardStats();
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-6xl">
      <AppNav user={user} currentPath={Astro.url.pathname} />

      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Dashboard
      </h1>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <a
          href="/orders?attention=1"
          class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl transition-colors hover:bg-white/15"
        >
          <TriangleAlert className="mb-3 size-6 text-amber-300" />
          <div class="text-3xl font-bold text-white">{stats.needsAttentionCount}</div>
          <div class="mt-1 text-sm text-blue-100/70">Wymagające uwagi</div>
        </a>

        <a
          href="/orders?blocked=1"
          class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl transition-colors hover:bg-white/15"
        >
          <Ban className="mb-3 size-6 text-red-300" />
          <div class="text-3xl font-bold text-white">{stats.blockedCount}</div>
          <div class="mt-1 text-sm text-blue-100/70">Zablokowane zamówienia</div>
        </a>

        <a
          href="/orders?overdue_payment=1"
          class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl transition-colors hover:bg-white/15"
        >
          <Wallet className="mb-3 size-6 text-orange-300" />
          <div class="text-3xl font-bold text-white">{stats.overduePaymentCount}</div>
          <div class="mt-1 text-sm text-blue-100/70">Płatność po terminie</div>
        </a>

        <a
          href="/orders"
          class="rounded-2xl border border-white/10 bg-white/10 p-5 backdrop-blur-xl transition-colors hover:bg-white/15"
        >
          <CircleDollarSign className="mb-3 size-6 text-emerald-300" />
          {
            stats.inProgressTotals.length === 0 ? (
              <div class="text-lg font-semibold text-white">Brak zamówień w toku</div>
            ) : (
              <ul class="space-y-0.5">
                {stats.inProgressTotals.map((t) => (
                  <li class="text-lg font-bold text-white">
                    {formatMoney(t.total)} <span class="text-sm font-normal text-blue-100/70">{t.currencyCode}</span>
                  </li>
                ))}
              </ul>
            )
          }
          <div class="mt-1 text-sm text-blue-100/70">Wartość zamówień w toku</div>
        </a>
      </div>
    </div>
  </div>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import { ServerError } from "@/components/auth/ServerError";
import { listUsers } from "@/lib/users";

const { user } = Astro.locals;
if (user?.role !== "admin") {
  return Astro.redirect("/orders");
}

const error = Astro.url.searchParams.get("error");
const users = listUsers();
---

<Layout title="Użytkownicy">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-4xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Użytkownicy
        </h1>
        <a href="/orders" class="text-sm text-blue-100/70 hover:text-white">&larr; Wróć do listy</a>
      </div>

      <div class="mb-6">
        <ServerError message={error} />
      </div>

      <div class="mb-6 overflow-x-auto rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl">
        <table class="w-full min-w-[700px] text-left text-sm text-white">
          <thead class="border-b border-white/10 text-blue-100/70">
            <tr>
              <th class="px-4 py-3 font-medium">Login</th>
              <th class="px-4 py-3 font-medium">Rola</th>
              <th class="px-4 py-3 font-medium">Nowe hasło</th>
              <th class="px-4 py-3 font-medium">Konto</th>
            </tr>
          </thead>
          <tbody>
            {
              users.map((u) => (
                <tr class="border-b border-white/5 last:border-0">
                  <td class="px-4 py-3">
                    {u.username}
                    {u.id === user.id && <span class="ml-2 text-xs text-blue-100/50">(Ty)</span>}
                  </td>
                  <td class="px-4 py-3">
                    <form method="POST" action={`/api/users/${u.id}/role`} class="flex items-center gap-2">
                      <select
                        name="role"
                        class="rounded-lg border border-white/20 bg-white/10 px-2 py-1.5 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
                      >
                        <option value="user" selected={u.role === "user"} class="text-black">
                          Użytkownik
                        </option>
                        <option value="admin" selected={u.role === "admin"} class="text-black">
                          Administrator
                        </option>
                      </select>
                      <button
                        type="submit"
                        class="shrink-0 rounded-lg border border-white/20 px-2 py-1.5 text-xs text-blue-100/80 hover:bg-white/10"
                      >
                        Zapisz
                      </button>
                    </form>
                  </td>
                  <td class="px-4 py-3">
                    <form method="POST" action={`/api/users/${u.id}/password`} class="flex items-center gap-2">
                      <input
                        type="password"
                        name="password"
                        placeholder="min. 8 znaków"
                        minlength={8}
                        required
                        class="w-full rounded-lg border border-white/20 bg-white/10 px-2 py-1.5 text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-purple-400 focus:outline-none"
                      />
                      <button
                        type="submit"
                        class="shrink-0 rounded-lg border border-white/20 px-2 py-1.5 text-xs text-blue-100/80 hover:bg-white/10"
                      >
                        Resetuj
                      </button>
                    </form>
                  </td>
                  <td class="px-4 py-3">
                    {u.id === user.id ? (
                      <span class="text-xs text-blue-100/40">—</span>
                    ) : (
                      <form
                        method="POST"
                        action={`/api/users/${u.id}/delete`}
                        onsubmit={`return confirm('Usunąć konto „${u.username}”? Tej operacji nie można cofnąć.');`}
                      >
                        <button type="submit" class="text-xs text-red-300 hover:text-red-100">
                          Usuń
                        </button>
                      </form>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/10 p-4 text-white backdrop-blur-xl">
        <h2 class="mb-3 text-lg font-semibold">Nowe konto</h2>
        <form method="POST" action="/api/users" class="flex flex-wrap items-end gap-3">
          <div>
            <label for="username" class="mb-1 block text-xs text-blue-100/70">Login</label>
            <input
              id="username"
              name="username"
              maxLength={50}
              required
              class="rounded-lg border border-white/20 bg-white/10 px-2 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>
          <div>
            <label for="password" class="mb-1 block text-xs text-blue-100/70">Hasło</label>
            <input
              id="password"
              type="password"
              name="password"
              minlength={8}
              required
              class="rounded-lg border border-white/20 bg-white/10 px-2 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>
          <div>
            <label for="role" class="mb-1 block text-xs text-blue-100/70">Rola</label>
            <select
              id="role"
              name="role"
              class="rounded-lg border border-white/20 bg-white/10 px-2 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            >
              <option value="user" class="text-black">Użytkownik</option>
              <option value="admin" class="text-black">Administrator</option>
            </select>
          </div>
          <button
            type="submit"
            class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            Utwórz konto
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

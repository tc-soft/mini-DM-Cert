---
import Layout from "@/layouts/Layout.astro";
import { listOrders, listOrderFilterOptions } from "@/lib/orders";
import { formatMoney } from "@/lib/money";
import { queryParam } from "@/lib/http";
import { TriangleAlert } from "lucide-react";

// Query params are the only place these live — nothing is persisted server-side, so filtering
// never changes the default view another user sees (FR-005).
const filters = {
  q: queryParam(Astro.url, "q"),
  product: queryParam(Astro.url, "product"),
  supplier: queryParam(Astro.url, "supplier"),
  currency: queryParam(Astro.url, "currency"),
  etaFrom: queryParam(Astro.url, "eta_from"),
  etaTo: queryParam(Astro.url, "eta_to"),
  onlyAttention: queryParam(Astro.url, "attention") === "1",
};
const hasActiveFilters = Object.values(filters).some((v) => v !== null && v !== false);

const orders = listOrders(filters);
const filterOptions = listOrderFilterOptions();
const { user } = Astro.locals;
---

<Layout title="Zamówienia">
  <div class="bg-cosmic min-h-screen p-4 py-10">
    <div class="mx-auto w-full max-w-6xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          Zamówienia
        </h1>
        <div class="flex items-center gap-3">
          {
            user?.role === "admin" && (
              <>
                <a href="/admin/users" class="text-sm text-blue-100/70 hover:text-white">
                  Użytkownicy
                </a>
                <a href="/admin/dictionaries" class="text-sm text-blue-100/70 hover:text-white">
                  Słowniki
                </a>
              </>
            )
          }
          <a href="/reports" class="text-sm text-blue-100/70 hover:text-white">Raport</a>
          <a
            href="/orders/new"
            class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            + Nowe zamówienie
          </a>
        </div>
      </div>

      <form
        method="GET"
        action="/orders"
        class="mb-4 rounded-2xl border border-white/10 bg-white/10 p-4 backdrop-blur-xl"
      >
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-7">
          <div class="lg:col-span-2">
            <label for="q" class="mb-1 block text-xs text-blue-100/70">Szukaj</label>
            <input
              id="q"
              name="q"
              value={filters.q ?? ""}
              placeholder="nr zamówienia, towar, dostawca, kontener, uwagi…"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>

          <div>
            <label for="product" class="mb-1 block text-xs text-blue-100/70">Towar</label>
            <select
              id="product"
              name="product"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            >
              <option value="" class="text-black"> Wszystkie </option>
              {
                filterOptions.products.map((p) => (
                  <option value={p} selected={filters.product === p} class="text-black">
                    {p}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="supplier" class="mb-1 block text-xs text-blue-100/70">Dostawca</label>
            <select
              id="supplier"
              name="supplier"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            >
              <option value="" class="text-black"> Wszyscy </option>
              {
                filterOptions.suppliers.map((s) => (
                  <option value={s} selected={filters.supplier === s} class="text-black">
                    {s}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="currency" class="mb-1 block text-xs text-blue-100/70">Waluta</label>
            <select
              id="currency"
              name="currency"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white focus:ring-2 focus:ring-purple-400 focus:outline-none"
            >
              <option value="" class="text-black"> Wszystkie </option>
              {
                filterOptions.currencies.map((c) => (
                  <option value={c} selected={filters.currency === c} class="text-black">
                    {c}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="eta_from" class="mb-1 block text-xs text-blue-100/70">Dostawa od</label>
            <input
              id="eta_from"
              name="eta_from"
              type="date"
              value={filters.etaFrom ?? ""}
              class="w-full rounded-lg border border-white/20 bg-white/10 px-2 py-2 text-sm text-white [color-scheme:dark] focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>

          <div>
            <label for="eta_to" class="mb-1 block text-xs text-blue-100/70">Dostawa do</label>
            <input
              id="eta_to"
              name="eta_to"
              type="date"
              value={filters.etaTo ?? ""}
              class="w-full rounded-lg border border-white/20 bg-white/10 px-2 py-2 text-sm text-white [color-scheme:dark] focus:ring-2 focus:ring-purple-400 focus:outline-none"
            />
          </div>
        </div>

        <div class="mt-3 flex items-center gap-3">
          <button
            type="submit"
            class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
          >
            Filtruj
          </button>
          <label for="attention" class="flex items-center gap-2 text-sm text-blue-100/80">
            <input
              id="attention"
              name="attention"
              type="checkbox"
              value="1"
              checked={filters.onlyAttention}
              class="size-4 rounded border-white/30 bg-white/10 text-purple-500 focus:ring-purple-400"
            />
            Tylko wymagające uwagi
          </label>
          {
            hasActiveFilters && (
              <a href="/orders" class="text-sm text-blue-100/70 hover:text-white">
                Wyczyść filtry
              </a>
            )
          }
          <span class="text-sm text-blue-100/50">
            {orders.length}
            {orders.length === 1 ? "wynik" : "wyników"}
          </span>
        </div>
      </form>

      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-white/10 backdrop-blur-xl">
        <table class="w-full min-w-[900px] text-left text-sm text-white">
          <thead class="border-b border-white/10 text-blue-100/70">
            <tr>
              <th class="px-4 py-3 font-medium"><span class="sr-only">Uwaga</span></th>
              <th class="px-4 py-3 font-medium">Nr zamówienia</th>
              <th class="px-4 py-3 font-medium">Towar</th>
              <th class="px-4 py-3 font-medium">Dostawca</th>
              <th class="px-4 py-3 text-right font-medium">Ilość (kg)</th>
              <th class="px-4 py-3 text-right font-medium">Wartość</th>
              <th class="px-4 py-3 font-medium">Kontener</th>
              <th class="px-4 py-3 font-medium">ETA port</th>
              <th class="px-4 py-3 font-medium">ETA cel</th>
              <th class="px-4 py-3 font-medium">Dodał</th>
              <th class="px-4 py-3 font-medium">Akcje</th>
            </tr>
          </thead>
          <tbody>
            {
              orders.length === 0 ? (
                <tr>
                  <td colspan="11" class="px-4 py-8 text-center text-blue-100/50">
                    {hasActiveFilters ? "Brak zamówień pasujących do filtrów." : "Brak zamówień. Dodaj pierwsze."}
                  </td>
                </tr>
              ) : (
                orders.map((o) => (
                  <tr
                    class:list={[
                      "border-b border-white/5 last:border-0 hover:bg-white/5",
                      o.needs_attention === 1 && "bg-amber-500/10",
                    ]}
                  >
                    <td class="px-4 py-3">
                      {o.needs_attention === 1 && (
                        <TriangleAlert className="size-4 text-amber-300" aria-label="Wymaga uwagi" />
                      )}
                    </td>
                    <td class="px-4 py-3">{o.order_number ?? "—"}</td>
                    <td class="px-4 py-3">{o.product_name}</td>
                    <td class="px-4 py-3">{o.supplier_name}</td>
                    <td class="px-4 py-3 text-right">{o.quantity_kg.toLocaleString("pl-PL")}</td>
                    <td class="px-4 py-3 text-right">
                      {formatMoney(o.order_value)} {o.currency_code}
                    </td>
                    <td class="px-4 py-3">{o.container_number ?? "—"}</td>
                    <td class="px-4 py-3">{o.eta_port_date ?? "—"}</td>
                    <td class="px-4 py-3">{o.eta_destination_date ?? "—"}</td>
                    <td class="px-4 py-3 text-blue-100/70">{o.created_by}</td>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-3">
                        <a href={`/orders/${o.id}/edit`} class="text-blue-200 hover:text-white">
                          Edytuj
                        </a>
                        {user?.role === "admin" && (
                          <form
                            method="POST"
                            action={`/api/orders/${o.id}/delete`}
                            onsubmit="return confirm('Usunąć to zamówienie? Tej operacji nie można cofnąć.');"
                          >
                            <button type="submit" class="text-red-300 hover:text-red-100">
                              Usuń
                            </button>
                          </form>
                        )}
                      </div>
                    </td>
                  </tr>
                ))
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

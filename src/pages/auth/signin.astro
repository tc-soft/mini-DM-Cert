---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie">
  <div class="bg-cosmic flex min-h-screen justify-center p-4 pt-[14vh] sm:pt-[18vh]">
    <div class="w-full max-w-sm">
      <div class="mb-6 flex flex-col items-center gap-3 text-center">
        <div
          class="flex size-12 items-center justify-center rounded-2xl border border-white/10 bg-gradient-to-br from-blue-500/20 to-purple-500/20 text-purple-200 backdrop-blur-xl"
        >
          <img src="/logo.svg" alt="" aria-hidden="true" style="height: 40px; width: auto;" />
        </div>

        <div>
          <p class="text-xs font-semibold tracking-[0.2em] text-blue-200/50 uppercase">mini-DM</p>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            Logowanie
          </h1>
        </div>
      </div>

      <div
        class="rounded-2xl border border-white/10 bg-white/10 p-8 text-white shadow-2xl shadow-purple-950/40 backdrop-blur-xl"
      >
        <SignInForm serverError={error} client:load />
      </div>

      <p class="mt-4 text-center text-sm text-blue-100/60">
        Potrzebujesz konta? Poproś administratora o jego utworzenie.
      </p>
    </div>
  </div>
</Layout>
